FROM golang:1.27.2-bookworm AS go-tools

# gh, gitleaks and osv-scanner are built from pinned release commits with a current Go
# toolchain and patched modules, so the image does not ship the stale stdlib and
# dependency versions baked into upstream release binaries.
# Bump a tool's version together with the commit its tag points to.
# gitleaks 8.30.1 still requires klauspost/compress v1.17.11 (CVE-2026-63209,
# fixed in v1.18.7). Patch it on this build only: gh and osv-scanner already
# select newer releases, and a shared go get would downgrade them.
ARG GH_VERSION=2.102.0
ARG GH_COMMIT=fc4b137cdef0a6bd28fd461b7cf9c84a5812a8cd
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_COMMIT=83d9cd684c87d95d656c1458ef04895a7f1cbd8e
ARG OSV_SCANNER_VERSION=2.7.0
ARG OSV_SCANNER_COMMIT=bfe2f84abd2f09fe0b83ba7f6dad40d296762f40
ARG GO_X_MODULES="golang.org/x/net@v0.61.0 golang.org/x/crypto@v0.58.0 golang.org/x/text@v0.43.0 golang.org/x/sys@v0.49.0"
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-trimpath

RUN set -eu; \
    fetch() { \
      git clone --quiet --depth 1 --branch "v$2" "https://github.com/$1.git" "/src/$4"; \
      test "$(git -C "/src/$4" rev-parse HEAD)" = "$3"; \
      cd "/src/$4"; \
      for mod in $GO_X_MODULES; do \
        if grep -q "${mod%@*} " go.mod; then go get "$mod"; fi; \
      done; \
      go mod tidy; \
    }; \
    fetch cli/cli "$GH_VERSION" "$GH_COMMIT" gh; \
    go build -ldflags "-s -w -X github.com/cli/cli/v2/internal/build.Version=${GH_VERSION}" -o /out/gh ./cmd/gh; \
    fetch gitleaks/gitleaks "$GITLEAKS_VERSION" "$GITLEAKS_COMMIT" gitleaks; \
    go get github.com/klauspost/compress@v1.18.7; \
    go mod tidy; \
    go build -ldflags "-s -w -X github.com/zricethezav/gitleaks/v8/version.Version=${GITLEAKS_VERSION}" -o /out/gitleaks .; \
    fetch google/osv-scanner "$OSV_SCANNER_VERSION" "$OSV_SCANNER_COMMIT" osv-scanner; \
    go build -ldflags "-s -w" -o /out/osv-scanner ./cmd/osv-scanner

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        docker.io \
        git \
        gnupg \
    && rm -rf /var/lib/apt/lists/*

# gh for repo automation; gitleaks + osv-scanner for coding-backend verify (secret scan + dependency audit).
COPY --from=go-tools /out/gh /out/gitleaks /out/osv-scanner /usr/local/bin/

COPY docker/agent-runtime-constraints.txt /tmp/constraints.txt
RUN pip install --no-cache-dir -c /tmp/constraints.txt uv \
    && env UV_NO_CACHE=1 UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin \
        uv tool install --constraints /tmp/constraints.txt pip-audit \
    && chmod -R a+rX /opt/uv-tools

COPY pyproject.toml README.md LICENSE NOTICE ./
COPY runtime ./runtime
COPY scripts ./scripts
COPY config ./config
COPY skills ./skills
COPY workspace ./workspace
COPY evals ./evals

COPY scripts/mcporter /usr/local/bin/mcporter
RUN chmod +x /usr/local/bin/mcporter

RUN pip install --no-cache-dir -c /tmp/constraints.txt ".[google]" "psycopg[binary]" \
    && pip uninstall -y setuptools wheel \
    && rm /tmp/constraints.txt

EXPOSE 18789

CMD ["ts-harness"]
