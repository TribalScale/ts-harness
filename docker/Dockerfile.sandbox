FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash coreutils grep sed findutils git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY scripts/sandbox-worker.py /usr/local/bin/sandbox-worker
RUN chmod +x /usr/local/bin/sandbox-worker

CMD ["sandbox-worker"]
