# One coding job per container: the agent-runtime toolchains plus OpenCode, without the gateway.
ARG AGENT_RUNTIME_IMAGE=ts-harness-agent-runtime:latest
FROM ${AGENT_RUNTIME_IMAGE}

ARG OPENCODE_VERSION=latest
ENV TS_HARNESS_TOOLS_ROOT=/opt/tools

# Postgres and Redis for a repo's database and integration tests (implementation/test_services.py
# starts them on loopback per job). No cluster is created at install time; each job runs initdb.
RUN set -eu; \
    mkdir -p /etc/postgresql-common/createcluster.d; \
    echo 'create_main_cluster = false' > /etc/postgresql-common/createcluster.d/ts-harness.conf; \
    apt-get update; \
    apt-get install -y --no-install-recommends postgresql postgresql-contrib redis-server; \
    rm -rf /var/lib/apt/lists/*; \
    ls /usr/lib/postgresql/*/bin/initdb; redis-server --version

# MySQL-compatible MariaDB (Debian's) and MongoDB (official server build; Debian has none)
# for repos on those databases. MariaDB's package starts nothing at build time.
ARG MONGODB_VERSION=8.0.32
ARG MONGODB_SHA256_AMD64=b61cda162c6592347b7503c683145304f74c900b1c10a395520c7c24d3f8445c
ARG MONGODB_SHA256_ARM64=8cca3993520a7f189790264ee57fb5d55a91094fb4be5f06bbbaf67c974d273f
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends mariadb-server mariadb-client; \
    rm -rf /var/lib/apt/lists/*; \
    case "$(dpkg --print-architecture)" in \
      amd64) mongo_pkg="mongodb-linux-x86_64-debian12-${MONGODB_VERSION}"; mongo_sha="$MONGODB_SHA256_AMD64" ;; \
      arm64) mongo_pkg="mongodb-linux-aarch64-ubuntu2404-${MONGODB_VERSION}"; mongo_sha="$MONGODB_SHA256_ARM64" ;; \
    esac; \
    curl -fsSLo /tmp/mongodb.tgz "https://fastdl.mongodb.org/linux/${mongo_pkg}.tgz"; \
    echo "${mongo_sha}  /tmp/mongodb.tgz" | sha256sum -c -; \
    mkdir -p /opt/mongodb; tar -xzf /tmp/mongodb.tgz -C /opt/mongodb --strip-components=1; rm /tmp/mongodb.tgz; \
    ln -sf /opt/mongodb/bin/mongod /usr/local/bin/mongod; \
    mariadbd --version; mongod --version | head -1

# Chromium for a frontend repo's Playwright suite: the libraries `playwright install-deps chromium`
# lists for Debian 13, fonts for readable screenshots, and one browser build preinstalled. A repo
# on another Playwright version fetches its own build into the same directory at job time.
ARG PLAYWRIGHT_VERSION=1.59.1
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libcairo2 libcups2t64 \
      libdbus-1-3 libdrm2 libgbm1 libglib2.0-0t64 libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 \
      libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 libfontconfig1 libfreetype6 \
      fonts-noto-color-emoji fonts-liberation fonts-freefont-ttf fonts-ipafont-gothic fonts-wqy-zenhei; \
    rm -rf /var/lib/apt/lists/*; \
    npx --yes "playwright@${PLAYWRIGHT_VERSION}" install chromium; \
    rm -rf /root/.npm/_npx; \
    chmod -R a+rX "$PLAYWRIGHT_BROWSERS_PATH"

RUN set -eu; \
    install_dir="/opt/tools/opencode/${OPENCODE_VERSION}"; \
    npm install --no-audit --no-fund --prefix "$install_dir" "opencode-ai@${OPENCODE_VERSION}"; \
    # npm 12 skips install scripts unless allowed, and OpenCode's postinstall fetches its binary.
    # Running it here works on every npm; on older npm it already ran and repeats harmlessly.
    (cd "$install_dir/node_modules/opencode-ai" && node postinstall.mjs); \
    mkdir -p "$install_dir/bin"; \
    ln -sf ../node_modules/.bin/opencode "$install_dir/bin/opencode"; \
    ln -sfn "${OPENCODE_VERSION}" /opt/tools/opencode/current; \
    /opt/tools/opencode/current/bin/opencode --version; \
    mkdir -p /opt/tools/coding-backend-skills; \
    for dir in /app/skills/coding-backend/*/; do \
      if [ -f "$dir/SKILL.md" ]; then cp -a "$dir" /opt/tools/coding-backend-skills/; fi; \
    done; \
    chmod -R a+rX /opt/tools

WORKDIR /workspace
CMD ["python3", "/app/scripts/coding-worker.py"]
