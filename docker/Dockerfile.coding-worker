# One coding job per container: the agent-runtime toolchains plus OpenCode, without the gateway.
ARG AGENT_RUNTIME_IMAGE=ts-harness-agent-runtime:latest
FROM ${AGENT_RUNTIME_IMAGE}

ARG OPENCODE_VERSION=latest
ENV TS_HARNESS_TOOLS_ROOT=/opt/tools

RUN set -eu; \
    install_dir="/opt/tools/opencode/${OPENCODE_VERSION}"; \
    npm install --no-audit --no-fund --prefix "$install_dir" "opencode-ai@${OPENCODE_VERSION}"; \
    mkdir -p "$install_dir/bin"; \
    ln -sf ../node_modules/.bin/opencode "$install_dir/bin/opencode"; \
    ln -sfn "${OPENCODE_VERSION}" /opt/tools/opencode/current; \
    /opt/tools/opencode/current/bin/opencode --version; \
    mkdir -p /opt/tools/coding-backend-skills; \
    for dir in /app/skills/coding-backend/*/; do \
      if [ -f "$dir/SKILL.md" ]; then cp -a "$dir" /opt/tools/coding-backend-skills/; fi; \
    done; \
    chmod -R a+rX /opt/tools

WORKDIR /workspace
CMD ["python3", "/app/scripts/coding-worker.py"]
