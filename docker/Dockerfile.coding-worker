# One coding job per container: the agent-runtime toolchains plus OpenCode, without the gateway.
ARG AGENT_RUNTIME_IMAGE=ts-harness-agent-runtime:latest
FROM ${AGENT_RUNTIME_IMAGE}

ARG OPENCODE_VERSION=latest
ENV TS_HARNESS_TOOLS_ROOT=/opt/tools

# Postgres and Redis for a repo's database and integration tests (implementation/test_services.py
# starts them on loopback per job). No cluster is created at install time; each job runs initdb.
RUN set -eu; \
    mkdir -p /etc/postgresql-common/createcluster.d; \
    echo 'create_main_cluster = false' > /etc/postgresql-common/createcluster.d/ts-harness.conf; \
    apt-get update; \
    apt-get install -y --no-install-recommends postgresql postgresql-contrib redis-server; \
    rm -rf /var/lib/apt/lists/*; \
    ls /usr/lib/postgresql/*/bin/initdb; redis-server --version

RUN set -eu; \
    install_dir="/opt/tools/opencode/${OPENCODE_VERSION}"; \
    npm install --no-audit --no-fund --prefix "$install_dir" "opencode-ai@${OPENCODE_VERSION}"; \
    # npm 12 skips install scripts unless allowed, and OpenCode's postinstall fetches its binary.
    # Running it here works on every npm; on older npm it already ran and repeats harmlessly.
    (cd "$install_dir/node_modules/opencode-ai" && node postinstall.mjs); \
    mkdir -p "$install_dir/bin"; \
    ln -sf ../node_modules/.bin/opencode "$install_dir/bin/opencode"; \
    ln -sfn "${OPENCODE_VERSION}" /opt/tools/opencode/current; \
    /opt/tools/opencode/current/bin/opencode --version; \
    mkdir -p /opt/tools/coding-backend-skills; \
    for dir in /app/skills/coding-backend/*/; do \
      if [ -f "$dir/SKILL.md" ]; then cp -a "$dir" /opt/tools/coding-backend-skills/; fi; \
    done; \
    chmod -R a+rX /opt/tools

WORKDIR /workspace
CMD ["python3", "/app/scripts/coding-worker.py"]
