FROM python:3.12-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    curl \
    jq \
    awscli \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir "psycopg[binary]" "psycopg-pool" "boto3>=1.34"

COPY scripts/memory-gateway.py /app/memory-gateway.py
COPY scripts/memory_routes/ /app/memory_routes/
COPY scripts/embed.sh /scripts/embed.sh

RUN chmod +x /scripts/embed.sh

CMD ["python3", "/app/memory-gateway.py"]
