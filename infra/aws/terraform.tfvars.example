# ──────────────────────────────────────────────────────────────
# Required variables (no defaults — must be set)
# ──────────────────────────────────────────────────────────────

# Name of an existing AWS EC2 key pair for SSH access
ssh_key_name = "my-keypair"

# CIDR blocks allowed to reach SSH on port 2222
ssh_allowed_cidrs = ["203.0.113.0/24"]

# ──────────────────────────────────────────────────────────────
# Optional variables (defaults shown, uncomment to override)
# ──────────────────────────────────────────────────────────────

# Git URL the instance clones for scripts/docker/workspace/skills (required for a working first boot)
# enterprise_repo_url = "https://github.com/TribalScale/ts-harness.git"

# Application repo for implement_work_orders / OpenCode (rendered into runtime YAML)
# implement_work_orders_repo_url    = "https://github.com/your-org/your-app.git"
# implement_work_orders_base_branch = "main"
# Pin OpenCode install (phase 11h OPENCODE_VERSION); prefer semver over latest
# implement_work_orders_opencode_version = "1.18.4"

# Admin identity (phase 11 renders these into runtime YAML via instance-env)
# identity_provider            = "oidc"
# oidc_issuer                  = "https://your-tenant.auth0.com/"
# oidc_audience                = "ts-harness"
# oidc_jwks_url                = "https://your-tenant.auth0.com/.well-known/jwks.json"
# oidc_client_id               = "your-spa-client-id"
# oidc_authorization_endpoint  = "https://your-tenant.auth0.com/authorize"
# oidc_token_endpoint          = "https://your-tenant.auth0.com/oauth/token"

# aws_region       = "us-east-1"
# instance_type    = "t3.medium"
# ebs_size         = 60
# root_volume_size = 40
# agent_runtime_version = "0.1.0"
# admin_username   = "artemis"
# project_name     = "ts-harness"

# Memory backend — set to "rds" to provision a managed PostgreSQL 16 instance
# memory_backend = "local"

# RDS instance class (only applies when memory_backend = "rds")
# rds_instance_class = "db.t3.micro"

# rds_skip_final_snapshot    = false
# rds_final_snapshot_identifier = "my-custom-final-name"

# Tailscale auth key stored in Secrets Manager — instance auto-joins on boot
# tailscale_authkey_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:tailscale-key-AbCdEf"

# ──────────────────────────────────────────────────────────────
# Workflow runner (optional, requires multi_agent_enabled = true)
# ──────────────────────────────────────────────────────────────

# workflow_runner_enabled = false
# workflow_runner_poll_interval_seconds = 10
# workflow_runner_batch_size = 5
# workflow_runner_lease_seconds = 1800
# workflow_runner_stale_policy = "block"
# coding_jobs_enabled = false
# coding_max_running = 3

# ──────────────────────────────────────────────────────────────
# Scale-out (deployment_profile = "scale_out" requires network_mode = "vpc")
# ──────────────────────────────────────────────────────────────

# deployment_profile                  = "single_host"
# network_mode                        = "default"
# vpc_cidr                            = "10.40.0.0/16"
# coding_worker_image_tag             = "latest"
# coding_worker_cpu                   = 2048
# coding_worker_memory                = 4096
# coding_worker_ephemeral_storage_gib = 50
# memory_api_certificate_arn          = ""
# egress_allowed_domains              = []

# ──────────────────────────────────────────────────────────────
# Redis / ElastiCache (optional, requires vpc_id and redis_subnet_ids)
# ──────────────────────────────────────────────────────────────

# enable_redis       = false
# vpc_id             = "vpc-xxxxxxxx"
# redis_subnet_ids   = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]
# redis_node_type    = "cache.t3.micro"
# redis_multi_az     = false
