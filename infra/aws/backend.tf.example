# Remote state for team deployments — copy to backend.tf and fill in your bucket/table.
#
#   cp backend.tf.example backend.tf
#
terraform {
  backend "s3" {
    bucket         = "ts-harness-tf-state"
    key            = "ts-harness/terraform.tfstate"
    region         = "us-east-1"
    # use_lockfile = true
    dynamodb_table = "terraform-locks"
    encrypt        = true
  }
}
