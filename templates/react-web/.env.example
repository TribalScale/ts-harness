# Copy to .env.local for local development. Vite exposes only VITE_* variables to the browser,
# so never put secrets here.
VITE_API_URL=http://localhost:3000

# Microsoft Entra ID: the SPA's app registration and the API scope it requests
VITE_AUTH_MODE=msal
VITE_AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
