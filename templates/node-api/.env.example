# Copy to .env for local development. Never commit real values; production values come from
# AWS Secrets Manager.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres (docker compose up -d db)
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Microsoft Entra ID: the API's app registration
AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
AUTH_AUDIENCE=api://00000000-0000-0000-0000-000000000000

# Tests only: signs and verifies test tokens instead of Entra ID. Refused outside NODE_ENV=test.
AUTH_TEST_SECRET=

# Nightly smoke run only (npm run start:smoke sets both): also accept tokens from the CI-only
# test issuer, verified with this public key (PEM). Refused at startup when NODE_ENV=production.
AUTH_TEST_ISSUER=false
AUTH_TEST_PUBLIC_KEY=
