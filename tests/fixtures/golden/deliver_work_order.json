{
  "workflow_type": "deliver_work_order",
  "definition_version": "1.4.0",
  "display_name": "Deliver one work order",
  "contracts": {
    "deliver_work_order": {
      "name": "deliver_work_order",
      "output_schema": {
        "type": "object",
        "required": [
          "work_order_id",
          "pr_url"
        ],
        "properties": {
          "work_order_id": {
            "type": "string",
            "minLength": 1
          },
          "pr_url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      },
      "required_artifacts": {
        "pr_url": "/pr_url"
      },
      "semantic_validators": [
        "validate_coding_backend_pr_url"
      ],
      "outcome": null
    },
    "code_review": {
      "name": "code_review",
      "output_schema": {
        "type": "object",
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "verdict",
              "summary",
              "prs",
              "findings"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "pass",
                  "block"
                ]
              },
              "summary": {
                "type": "string"
              },
              "prs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "pr_url"
                  ],
                  "properties": {
                    "pr_url": {
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "head_sha": {
                      "type": "string"
                    }
                  }
                }
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "severity",
                    "category",
                    "pr_url",
                    "message"
                  ],
                  "properties": {
                    "severity": {
                      "enum": [
                        "blocker",
                        "major",
                        "minor",
                        "nit"
                      ]
                    },
                    "category": {
                      "enum": [
                        "correctness",
                        "security",
                        "scope",
                        "tests",
                        "maintainability"
                      ]
                    },
                    "pr_url": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      },
      "required_artifacts": {},
      "semantic_validators": [
        "validate_code_review_envelope"
      ],
      "outcome": null
    },
    "qa_gate": {
      "name": "qa_gate",
      "output_schema": {
        "type": "object",
        "required": [
          "status",
          "result"
        ],
        "properties": {
          "status": {
            "enum": [
              "success",
              "failed"
            ]
          },
          "result": {
            "type": "object",
            "required": [
              "prs"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "prs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "pr_url",
                    "work_item_ref",
                    "status"
                  ],
                  "properties": {
                    "pr_url": {
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "work_item_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "enum": [
                        "success",
                        "failed"
                      ]
                    },
                    "acceptance_criteria": {
                      "type": "array"
                    },
                    "tests": {
                      "type": "array"
                    },
                    "defects": {
                      "type": "array"
                    },
                    "summary": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "warnings": {
            "type": "array"
          },
          "follow_up_needed": {
            "type": "boolean"
          }
        }
      },
      "required_artifacts": {},
      "semantic_validators": [
        "validate_qa_pr_url_set"
      ],
      "outcome": {
        "pointer": "/status",
        "succeeded_values": [
          "success"
        ],
        "blocked_values": [
          "failed"
        ]
      }
    }
  },
  "notifications": {
    "bound_channel": false,
    "events": []
  },
  "on_workflow_cancel": {
    "hook": "cancel_workflow"
  },
