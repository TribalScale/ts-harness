#!/usr/bin/env python3
"""TS Harness MCP stdio adapter for Atlassian integrations."""

from __future__ import annotations

import base64
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request


TOOLS = [
    {
        "name": "atlassian_search",
        "description": "Search Jira issues through the configured Atlassian MCP bridge.",
        "inputSchema": {
            "type": "object",
            "properties": {"query": {"type": "string"}},
            "required": ["query"],
        },
    }
]


def _atlassian_site() -> str | None:
    site = os.environ.get("ATLASSIAN_SITE_URL") or os.environ.get("JIRA_URL") or ""
    site = site.strip().rstrip("/")
    if not site:
        return None
    if site.startswith("http://") or site.startswith("https://"):
        return site
    return f"https://{site}"


def _atlassian_auth_header() -> str | None:
    token = os.environ.get("ATLASSIAN_API_TOKEN") or os.environ.get("JIRA_API_TOKEN") or ""
    email = os.environ.get("ATLASSIAN_EMAIL") or os.environ.get("JIRA_USERNAME") or ""
    token = token.strip()
    if not token:
        return None
    if email:
        raw = f"{email}:{token}".encode()
        return "Basic " + base64.b64encode(raw).decode()
    return f"Bearer {token}"


def _atlassian_search(query: str) -> str:
    site = _atlassian_site()
    auth = _atlassian_auth_header()
    if not site or not auth:
        return (
            "Atlassian credentials are not configured. "
            "Set ATLASSIAN_SITE_URL and ATLASSIAN_API_TOKEN (or JIRA_URL/JIRA_API_TOKEN)."
        )
    jql = query if "=" in query or query.strip().upper().startswith("ORDER BY") else f'text ~ "{query}"'
    params = urllib.parse.urlencode({"jql": jql, "maxResults": "5", "fields": "summary,status,key"})
    request = urllib.request.Request(
        f"{site}/rest/api/3/search?{params}",
        headers={"Authorization": auth, "Accept": "application/json"},
        method="GET",
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            payload = json.loads(response.read())
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")[:300]
        return f"Atlassian search failed ({exc.code}): {body}"
    except urllib.error.URLError as exc:
        return f"Atlassian search failed: {exc.reason}"

    issues = payload.get("issues") or []
    if not issues:
        return f"No Jira issues found for query: {query}"
    lines = []
    for issue in issues:
        fields = issue.get("fields") or {}
        status = (fields.get("status") or {}).get("name", "unknown")
        lines.append(f"{issue.get('key')}: {fields.get('summary', '')} [{status}]")
    return "\n".join(lines)


def _handle_call(params: dict) -> dict:
    name = params.get("name")
    arguments = params.get("arguments") or {}
    if name == "atlassian_search":
        text = _atlassian_search(str(arguments.get("query", "")))
        return {"content": [{"type": "text", "text": text}]}
    return {"content": [{"type": "text", "text": f"Unknown MCP tool: {name}"}]}


def main() -> None:
    for line in sys.stdin:
        request = json.loads(line)
        method = request.get("method")
        if method == "tools/list":
            result = {"tools": TOOLS}
        elif method == "tools/call":
            result = _handle_call(request.get("params") or {})
        else:
            result = {}
        print(json.dumps({"jsonrpc": "2.0", "id": request.get("id"), "result": result}), flush=True)


if __name__ == "__main__":
    main()
