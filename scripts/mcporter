#!/usr/bin/env python3
"""TS Harness MCP stdio adapter for Atlassian integrations."""

from __future__ import annotations

import json
import sys
import urllib.parse

from ts_harness.integrations.atlassian_auth import AtlassianAuth, AtlassianAuthError
from ts_harness.integrations.github_client import _urllib_transport


TOOLS = [
    {
        "name": "atlassian_search",
        "description": "Search Jira issues through the configured Atlassian MCP bridge.",
        "inputSchema": {
            "type": "object",
            "properties": {"query": {"type": "string"}},
            "required": ["query"],
        },
    }
]


NOT_CONFIGURED = (
    "Atlassian credentials are not configured. Set ATLASSIAN_CLIENT_ID and ATLASSIAN_CLIENT_SECRET "
    "(service account), or ATLASSIAN_SITE_URL, ATLASSIAN_EMAIL and ATLASSIAN_API_TOKEN."
)

_auth: AtlassianAuth | None = None
transport = _urllib_transport


def _get_auth() -> AtlassianAuth | None:
    global _auth
    if _auth is None:
        try:
            _auth = AtlassianAuth.from_env(transport=transport)
        except AtlassianAuthError:
            return None
    return _auth


def _search(auth: AtlassianAuth, params: str) -> tuple[int, bytes]:
    headers = {"Authorization": auth.authorization(), "Accept": "application/json", "User-Agent": "ts-harness"}
    response = transport("GET", f"{auth.base_url()}/rest/api/3/search/jql?{params}", headers, None)
    return response[0], response[1]


def _atlassian_search(query: str) -> str:
    auth = _get_auth()
    if auth is None:
        return NOT_CONFIGURED
    jql = query if "=" in query or query.strip().upper().startswith("ORDER BY") else f'text ~ "{query}"'
    params = urllib.parse.urlencode({"jql": jql, "maxResults": "5", "fields": "summary,status"})
    try:
        status, raw = _search(auth, params)
        if status == 401 and auth.mode == "oauth":
            auth.invalidate()
            status, raw = _search(auth, params)
    except AtlassianAuthError as exc:
        return f"Atlassian search failed: {exc}"
    except OSError as exc:
        return f"Atlassian search failed: {exc}"
    if status >= 400:
        body = raw.decode("utf-8", errors="replace")[:300] if raw else ""
        return f"Atlassian search failed ({status}): {body}"
    payload = json.loads(raw.decode()) if raw else {}

    issues = payload.get("issues") or []
    if not issues:
        return f"No Jira issues found for query: {query}"
    lines = []
    for issue in issues:
        fields = issue.get("fields") or {}
        status = (fields.get("status") or {}).get("name", "unknown")
        lines.append(f"{issue.get('key')}: {fields.get('summary', '')} [{status}]")
    return "\n".join(lines)


def _handle_call(params: dict) -> dict:
    name = params.get("name")
    arguments = params.get("arguments") or {}
    if name == "atlassian_search":
        text = _atlassian_search(str(arguments.get("query", "")))
        return {"content": [{"type": "text", "text": text}]}
    return {"content": [{"type": "text", "text": f"Unknown MCP tool: {name}"}]}


def main() -> None:
    for line in sys.stdin:
        request = json.loads(line)
        method = request.get("method")
        if method == "tools/list":
            result = {"tools": TOOLS}
        elif method == "tools/call":
            result = _handle_call(request.get("params") or {})
        else:
            result = {}
        print(json.dumps({"jsonrpc": "2.0", "id": request.get("id"), "result": result}), flush=True)


if __name__ == "__main__":
    main()
