{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ts-harness:schemas:prd-to-work-orders:frd",
  "title": "Feature Requirement Document Contract",
  "type": "object",
  "required": [
    "frdId",
    "title",
    "parentFeature",
    "dependencies",
    "personas",
    "businessProblemLink",
    "overview",
    "terminology",
    "requirements"
  ],
  "properties": {
    "frdId": {
      "type": "string",
      "pattern": "^FRD-[0-9]{3}[a-z]?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "parentFeature": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FRD-[0-9]{3}[a-z]?$"
      }
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "businessProblemLink": {
      "type": "string",
      "minLength": 1
    },
    "overview": {
      "type": "string",
      "minLength": 1
    },
    "terminology": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "definition"],
        "properties": {
          "term": { "type": "string" },
          "definition": { "type": "string" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "userStory", "acceptanceCriteria"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[A-Z0-9-]+-[0-9]{3}$"
          },
          "name": { "type": "string" },
          "userStory": {
            "type": "string",
            "pattern": "^As a .+, I want to .+, so that .+\\.$"
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-[A-Z0-9-]+-[0-9]{3}\\.[0-9]+$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^When .+, the system shall .+\\.$"
                }
              }
            }
          }
        }
      }
    }
  }
}
