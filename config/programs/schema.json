{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TS Harness program definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program_type",
    "definition_version",
    "display_name",
    "startable_nodes",
    "nodes",
    "edges"
  ],
  "properties": {
    "program_type": { "type": "string", "minLength": 1 },
    "definition_version": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "required_permission": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "startable_nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/edge" }
    },
    "config": { "$ref": "#/definitions/program_config" }
  },
  "definitions": {
    "program_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo_picker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["inherit", "custom"] },
            "repos": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "default_branch": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "jira_filing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["inherit", "custom"] },
            "default_issue_type": { "type": "string", "minLength": 1 },
            "issue_type_by_project": {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        },
        "ticket_picker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["inherit", "custom"] },
            "assignee": { "type": "string", "minLength": 1 },
            "statuses": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "default_workflow_type",
        "workflow_variants",
        "required_artifacts",
        "produces_artifacts",
        "input_bindings",
        "completion_adapter",
        "terminal"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "default_workflow_type": { "type": "string", "minLength": 1 },
        "workflow_variants": {
          "type": "array",
          "items": { "$ref": "#/definitions/workflow_variant" }
        },
        "required_artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "produces_artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "input_bindings": {
          "type": "array",
          "items": { "$ref": "#/definitions/input_binding" }
        },
        "completion_adapter": { "type": "string", "minLength": 1 },
        "terminal": { "type": "boolean" },
        "reentry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_node"],
          "properties": {
            "target_node": { "type": "string", "minLength": 1 },
            "next_item_artifact": { "type": "string", "minLength": 1 },
            "completed_list_artifact": { "type": "string", "minLength": 1 },
            "remaining_list_artifact": { "type": "string", "minLength": 1 },
            "mode": { "type": "string", "enum": ["list", "work_orders"] },
            "max_iterations": { "type": "integer", "minimum": 1, "maximum": 500 }
          }
        },
        "complete_channel_text": { "type": "string" },
        "await_children": { "type": "boolean" },
        "required_permission": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      }
    },
    "workflow_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_type", "when"],
      "properties": {
        "workflow_type": { "type": "string", "minLength": 1 },
        "when": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      }
    },
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "program_summary",
            "artifact",
            "static",
            "transcript_context"
          ]
        },
        "target": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "value": {},
        "limit": { "type": "integer", "minimum": 1 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "mode"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["manual", "automatic"] },
        "confirm_required": { "type": "boolean" },
        "signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifact_patch": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      }
    }
  }
}
