{
  "workflow_type": "deploy_release",
  "definition_version": "3.0.0",
  "display_name": "Deploy release",
  "program": {
    "phase": "release",
    "next_phase": null,
    "required_artifacts": [
      "merge_sha"
    ],
    "auto_advance": false,
    "terminal": true
  },
  "promotion": {
    "confirm_required": false,
    "intake_stage": "plan_release_tracks",
    "binding": {
      "format": "{channel}:{channel_id}:{thread_id}"
    }
  },
  "notifications": {
    "bound_channel": true,
    "events": [
      "completed",
      "blocked",
      "failed",
      "awaiting_approval",
      "awaiting_external"
    ]
  },
  "on_workflow_cancel": {
    "hook": "cancel_workflow"
  },
  "on_workflow_complete": {
    "hook": "complete_program_phase"
  },
  "stages": [
    {
      "name": "plan_release_tracks",
      "kind": "task",
      "agent_id": "orchestrator",
      "barrier": {
        "hook": "plan_release_tracks",
        "workflow_type": "release_track"
      },
      "retry": {
        "max_retries": 0,
        "timeout_seconds": 600
      }
    },
    {
      "name": "join_tracks",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": [
        "plan_release_tracks"
      ],
      "approval_required": false,
      "wait_external": {
        "hook": "wait_external",
        "event_type": "workflow.child_terminal",
        "children": {
          "source": "$prior.plan_release_tracks.output.children"
        },
        "timeout_seconds": 1209600
      },
      "retry": {
        "max_retries": 0,
        "timeout_seconds": 1209600
      }
    }
  ]
}
