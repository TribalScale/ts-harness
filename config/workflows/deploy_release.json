{
  "workflow_type": "deploy_release",
  "definition_version": "2.0.0",
  "display_name": "Deploy release",
  "program": {
    "phase": "release",
    "next_phase": null,
    "required_artifacts": ["merge_sha"],
    "auto_advance": false,
    "terminal": true
  },
  "promotion": {
    "confirm_required": false,
    "intake_stage": "plan_release",
    "binding": { "format": "{channel}:{channel_id}:{thread_id}" }
  },
  "notifications": {
    "bound_channel": true,
    "events": ["completed", "blocked", "failed", "awaiting_approval", "awaiting_external"]
  },
  "on_workflow_cancel": { "hook": "cancel_workflow" },
  "on_workflow_complete": { "hook": "complete_program_phase" },
  "stages": [
    {
      "name": "plan_release",
      "kind": "task",
      "agent_id": "orchestrator",
      "barrier": {
        "hook": "plan_release",
        "gates": {
          "staging": "approve_promote_staging",
          "production": "approve_promote_production"
        }
      },
      "retry": { "max_retries": 0, "timeout_seconds": 600 }
    },
    {
      "name": "await_ci_on_sha",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": ["plan_release"],
      "approval_required": false,
      "wait_external": {
        "hook": "wait_external",
        "event_type": "github.pr_checks",
        "sha_checks": {
          "sha": "$prior.plan_release.output.sha",
          "repo": "$prior.plan_release.output.repo"
        },
        "block_when": { "checks_state": ["failure"] },
        "timeout_seconds": 7200
      },
      "retry": { "max_retries": 0, "timeout_seconds": 7200 }
    },
    {
      "name": "approve_promote_staging",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": ["await_ci_on_sha"],
      "approval_required": true,
      "approval": { "decision_kind": "promote", "require_dependencies_succeeded": true },
      "retry": { "max_retries": 0, "timeout_seconds": 86400 }
    },
    {
      "name": "trigger_deploy_staging",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": ["approve_promote_staging"],
      "barrier": { "hook": "trigger_deploy", "slot": "staging", "gate": "approve_promote_staging" },
      "retry": { "max_retries": 0, "timeout_seconds": 600 }
    },
    {
      "name": "await_deployment_staging",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": ["trigger_deploy_staging"],
      "approval_required": false,
      "wait_external": {
        "hook": "wait_external",
        "event_type": "github.deployment_status",
        "deployment": { "trigger_step": "trigger_deploy_staging" },
        "timeout_seconds": 3600
      },
      "retry": { "max_retries": 0, "timeout_seconds": 3600 }
    },
    {
      "name": "record_release_staging",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": ["await_deployment_staging"],
      "barrier": {
        "hook": "record_release",
        "trigger_step": "trigger_deploy_staging",
        "wait_step": "await_deployment_staging"
      },
      "retry": { "max_retries": 0, "timeout_seconds": 600 }
    },
    {
      "name": "approve_promote_production",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": ["record_release_staging"],
      "approval_required": true,
      "approval": { "decision_kind": "promote", "require_dependencies_succeeded": true },
      "retry": { "max_retries": 0, "timeout_seconds": 86400 }
    },
    {
      "name": "trigger_deploy_production",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": ["approve_promote_production"],
      "barrier": { "hook": "trigger_deploy", "slot": "production", "gate": "approve_promote_production" },
      "retry": { "max_retries": 0, "timeout_seconds": 600 }
    },
    {
      "name": "await_deployment_production",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": ["trigger_deploy_production"],
      "approval_required": false,
      "wait_external": {
        "hook": "wait_external",
        "event_type": "github.deployment_status",
        "deployment": { "trigger_step": "trigger_deploy_production" },
        "timeout_seconds": 3600
      },
      "retry": { "max_retries": 0, "timeout_seconds": 3600 }
    },
    {
      "name": "record_release_production",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": ["await_deployment_production"],
      "barrier": {
        "hook": "record_release",
        "trigger_step": "trigger_deploy_production",
        "wait_step": "await_deployment_production"
      },
      "retry": { "max_retries": 0, "timeout_seconds": 600 }
    }
  ]
}
