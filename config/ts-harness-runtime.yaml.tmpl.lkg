agents:
  list:
  - default: true
    heartbeat:
      activeHours:
        end: '22:00'
        start: 07:00
        timezone: '{{AGENT_TIMEZONE}}'
      every: 30m
      isolatedSession: true
      lightContext: true
      model: openai/gpt-4o-mini
      prompt: Read HEARTBEAT.md. If any item needs human attention, escalate per standing
        orders. Else reply HEARTBEAT_OK.
      target: none
    id: orchestrator
    model: openai/gpt-4o
    skills:
    - orchestrator
    - memory-api
    - workflow
    - workflows
    - governed-workflows
    - cost-awareness
    - audit-logging
    subagents:
      allowAgents:
      - dev-agent
      - ops-agent
      - qa-agent
      - review-agent
      - analyst-agent
      - pm-agent
      - comms-agent
      - marketing-agent
      - sales-agent
    tools:
      allow:
      - recall_memory
      - read_file
      - session_status
      - remember_memory
      - sessions_list
      - sessions_history
      - search_sessions
      - delegate_task
      - propose_delegate_task
      - workflow_update
      - propose_start_workflow
      - start_workflow
      - propose_start_program
      - start_program
      - propose_advance_program
      - advance_program
      - propose_set_program_project
      - set_program_project
      - propose_link_program
      - link_program
      - unlink_program
      - set_program_autoshare
      - program_status
      - propose_continue_delivery
      - continue_delivery
      - propose_bridge_workflow
      - bridge_workflow
      - workflow_status
      - workflow_approve
      - workflow_reject
      - workflow_reject_with_feedback
      - cancel_workflow
      - resume_external_event
      deny:
      - exec
      - write_file
      - patch_file
    toolsets:
    - core-read
    - workflow
    - delegation
    - channel-chat
    - workflow-promotion
    workspace: /workspace/orchestrator
  - id: dev-agent
    model: openai/gpt-4o
    skills:
    - dev
    - memory
    - workflows
    - integrate
    - governed-workflows
    tools:
      allow:
      - read_file
      - write_file
      - patch_file
      - exec
      - recall_memory
      - run_coding_backend
      - propose_skill
      deny:
      - delegate_task
    toolsets:
    - core-read
    - core-write
    - terminal
    - coding-backend
    - skill-authoring
    workspace: /workspace/dev-agent
  - heartbeat:
      activeHours:
        end: '22:00'
        start: 07:00
        timezone: '{{AGENT_TIMEZONE}}'
      every: 30m
      isolatedSession: true
      lightContext: true
      model: openai/gpt-4o-mini
      prompt: Run the System Monitoring program in HEARTBEAT.md. Return only deltas;
        reply HEARTBEAT_OK if nothing changed.
      target: slack
      to: channel:{{SLACK_OPS_CHANNEL}}
    id: ops-agent
    model: openai/gpt-4o
    skills:
    - ops
    - memory
    tools:
      allow:
      - read_file
      - exec
      - recall_memory
      - propose_skill
      deny:
      - write_file
      - patch_file
      - delegate_task
    toolsets:
    - core-read
    - terminal
    - skill-authoring
    workspace: /workspace/ops-agent
  - id: qa-agent
    model: openai/gpt-6-astra
    skills:
    - qa
    - memory
    - workflows
    - governed-workflows
    tools:
      allow:
      - read_file
      - recall_memory
      deny:
      - write_file
      - patch_file
      - exec
      - run_coding_backend
      - delegate_task
    toolsets:
    - core-read
    workspace: /workspace/qa-agent
  - id: review-agent
    model: openai/gpt-6-astra
    skills:
    - review
    - memory
    - governed-workflows
    tools:
      allow:
      - read_file
      - recall_memory
      deny:
      - write_file
      - patch_file
      - exec
      - delegate_task
      - run_coding_backend
    toolsets:
    - core-read
    workspace: /workspace/review-agent
  - id: analyst-agent
    model: openai/gpt-4o-mini
    skills:
    - memory
    tools:
      allow:
      - read_file
      - exec
      - recall_memory
      deny:
      - write_file
      - patch_file
      - delegate_task
    toolsets:
    - core-read
    - terminal
    workspace: /workspace/analyst-agent
  - connector_bindings:
      google-workspace: pm
    id: pm-agent
    model: openai/gpt-4o
    skills:
    - pm
    - memory-api
    - workflows
    - governed-workflows
    tools:
      allow:
      - read_file
      - recall_memory
      - workflow_update
      deny:
      - exec
      - write_file
      - patch_file
      - delegate_task
    toolsets:
    - core-read
    - workflow
    - google-workspace-docs
    workspace: /workspace/pm-agent
  - connector_bindings:
      google-workspace: comms
    heartbeat:
      activeHours:
        end: '22:00'
        start: 07:00
        timezone: '{{AGENT_TIMEZONE}}'
      every: 30m
      isolatedSession: true
      lightContext: true
      prompt: Scan unread mentions and DMs per HEARTBEAT.md. Surface only items requiring
        a human reply within 1h.
      target: none
    id: comms-agent
    model: openai/gpt-4o-mini
    skills:
    - comms
    - memory-api
    tools:
      allow:
      - read_file
      - channel_send
      - recall_memory
      - google_workspace_gmail_search
      - google_workspace_gmail_get
      - google_workspace_gmail_send
      - google_workspace_calendar_list
      - google_workspace_calendar_get
      - google_workspace_calendar_create
      - google_workspace_calendar_update
      - google_workspace_calendar_cancel
      - google_workspace_drive_search
      - google_workspace_drive_get
      - google_workspace_docs_read
      - google_workspace_connect
      - google_workspace_disconnect
      deny:
      - write_file
      - patch_file
      - delegate_task
      - exec
    toolsets:
    - core-read
    - channel
    - google-workspace
    workspace: /workspace/comms-agent
  - connector_bindings:
      google-workspace: marketing
    heartbeat:
      activeHours:
        end: '22:00'
        start: 07:00
        timezone: '{{AGENT_TIMEZONE}}'
      every: 30m
      isolatedSession: true
      lightContext: true
      model: openai/gpt-4o-mini
      prompt: Read HEARTBEAT.md. Check for campaign deadlines in the next 48h and
        overdue drafts. Reply HEARTBEAT_OK if nothing requires attention.
      target: none
    id: marketing-agent
    model: openai/gpt-4o
    skills:
    - memory-api
    tools:
      allow:
      - read_file
      - channel_send
      - recall_memory
      - google_workspace_gmail_search
      - google_workspace_gmail_get
      - google_workspace_calendar_list
      - google_workspace_calendar_get
      - google_workspace_connect
      - google_workspace_disconnect
      deny:
      - write_file
      - patch_file
      - delegate_task
      - exec
      - google_workspace_gmail_send
    toolsets:
    - core-read
    - channel
    - google-workspace-docs
    workspace: /workspace/marketing-agent
  - connector_bindings:
      google-workspace: sales
    heartbeat:
      activeHours:
        end: '22:00'
        start: 07:00
        timezone: '{{AGENT_TIMEZONE}}'
      every: 30m
      isolatedSession: true
      lightContext: true
      model: openai/gpt-4o-mini
      prompt: Read HEARTBEAT.md. Check pipeline follow-ups due today. Reply HEARTBEAT_OK
        if nothing requires attention.
      target: none
    id: sales-agent
    model: openai/gpt-4o
    skills:
    - memory-api
    - clarify-rfp
    - draft-rfp
    tools:
      allow:
      - read_file
      - channel_send
      - recall_memory
      - google_workspace_gmail_search
      - google_workspace_gmail_get
      - google_workspace_gmail_send
      - google_workspace_calendar_list
      - google_workspace_calendar_get
      - google_workspace_calendar_create
      - google_workspace_drive_search
      - google_workspace_connect
      - google_workspace_disconnect
      deny:
      - write_file
      - patch_file
      - delegate_task
      - exec
    toolsets:
    - core-read
    - channel
    - google-workspace
    workspace: /workspace/sales-agent
  - id: builder-agent
    model: openai/gpt-4o
    skills:
    - program-builder
    tools:
      deny:
      - exec
      - write_file
      - patch_file
      - delegate_task
    toolsets:
    - core-read
    - program-builder
    - skill-authoring
    workspace: /workspace/builder-agent
bindings:
  discord: orchestrator
  slack: orchestrator
  telegram: orchestrator
connectors:
  google-workspace:
    accounts:
      comms:
        impersonate_email: '{{GOOGLE_COMMS_EMAIL}}'
      marketing:
        impersonate_email: '{{GOOGLE_MARKETING_EMAIL}}'
      pm:
        impersonate_email: '{{GOOGLE_PM_EMAIL}}'
      sales:
        impersonate_email: '{{GOOGLE_SALES_EMAIL}}'
    artifact_publish:
      chunk_chars: 50000
      enabled: true
      folder_id: '{{GOOGLE_DELIVERY_ARTIFACTS_FOLDER_ID}}'
      library:
        enabled: true
        program_subfolder: programs
        publish_on: present
        share_folder_with_requester: true
        step_phase_map:
          prd_request:
            draft_prd: prd
            revise_prd: prd
          work_orders_from_prd:
            design_blueprints: foundry
            plan_work_orders: planner
            refine_requirements: refinery
      min_chars: 3000
    auth:
      delegation:
        credentials_secret: google-workspace-sa-json
        default_impersonate_email: '{{GOOGLE_WORKSPACE_DEFAULT_EMAIL}}'
      oauth:
        callback_url: '{{GOOGLE_OAUTH_CALLBACK_URL}}'
        client_id_secret: google-oauth-client-id
        client_secret_secret: google-oauth-client-secret
        kms_key_id: '{{CREDENTIALS_ENCRYPTION_KEY_ID}}'
    enabled: true
    scopes:
    - https://www.googleapis.com/auth/calendar
    - https://www.googleapis.com/auth/drive
    - https://www.googleapis.com/auth/gmail.readonly
    - https://www.googleapis.com/auth/gmail.send
    - https://www.googleapis.com/auth/documents
gateway:
  allowed_origins:
  - '{{CONTROL_UI_ALLOWED_ORIGIN}}'
  default_tenant_id: default
  single_tenant_mode: true
  token: super-secret-token-value
identity:
  audience: '{{OIDC_AUDIENCE}}'
  authorization_endpoint: '{{OIDC_AUTHORIZATION_ENDPOINT}}'
  client_id: '{{OIDC_CLIENT_ID}}'
  issuer: '{{OIDC_ISSUER}}'
  jira_account_ids: {}
  jwks_url: '{{OIDC_JWKS_URL}}'
  provider: '{{IDENTITY_PROVIDER}}'
  scim_enabled: false
  token_endpoint: '{{OIDC_TOKEN_ENDPOINT}}'
implementation:
  backends:
    opencode:
      auth_env: CODING_BACKEND_API_KEY
      binary: opencode
      model: '{{CODING_BACKEND_MODEL}}'
      provider: '{{CODING_BACKEND_PROVIDER}}'
      run_args:
      - run
      - --auto
      version: '{{OPENCODE_VERSION}}'
  coding_backend: opencode
  repos:
    implement_jira_ticket:
      base_branch: '{{IMPLEMENT_JIRA_TICKET_BASE_BRANCH}}'
      clone_depth: 1
      url: '{{IMPLEMENT_JIRA_TICKET_REPO_URL}}'
    implement_work_orders:
      base_branch: '{{IMPLEMENT_WORK_ORDERS_BASE_BRANCH}}'
      clone_depth: 1
      url: '{{IMPLEMENT_WORK_ORDERS_REPO_URL}}'
  tools_root: /tools
mcp_servers:
  atlassian:
    command: mcporter
    enabled: true
    transport: stdio
policy:
  approval_required_tools:
  - exec
  - write_file
  - delegate_task
  - google_workspace_gmail_send
  - google_workspace_calendar_create
  - google_workspace_calendar_update
  - google_workspace_calendar_cancel
  budget_hard_stop_usd: 100.0
  budget_warn_usd: 50.0
  channel_ingress_deny:
  - exec
  - write_file
  - delegation
  - workflow_update
  delegation_auto_allow_agents:
  - pm-agent
  - analyst-agent
  model_allowlist:
    qa-agent:
    - openai/gpt-6-astra
    review-agent:
    - openai/gpt-6-astra
program_builder:
  agent_id: builder-agent
program_defaults:
  jira_filing:
    default_issue_type: Story
    issue_type_by_project: {}
  repo_picker:
    repos: []
  ticket_picker:
    assignee: mapped_user
    statuses:
    - To Do
    - Open
    - Ready for Dev
    - In Progress
routing:
  default: ad_hoc_delegate
  intents:
  - exclude:
    - quick
    - rough draft
    - no approval
    id: governed_prd
    orchestrator_hint: 'User request requires a governed workflow. Call propose_start_workflow
      with workflow_type=prd_request. Do not call propose_delegate_task.

      '
    policy:
      deny_start_workflow_types:
      - governed_delivery
      deny_tools:
      - propose_delegate_task
      - delegate_task
      mode: require_workflow
    signals:
    - create a prd
    - create prd
    - draft prd
    - write a prd
    - product requirements document
    workflow_type: prd_request
  - delegate_agent: pm-agent
    id: informal_prd
    policy:
      deny_start_workflow_types:
      - prd_request
      mode: require_delegate
    signals:
    - quick prd
    - rough outline
    - rough draft
    - quick draft
    - no approval
  - entry_phase: intake
    id: content_to_jira
    orchestrator_hint: 'User wants the decoupled planning program. Call propose_start_program
      with program_type=content_to_jira_work_orders and entry_phase=intake. Do not
      call propose_delegate_task or start software_delivery.

      '
    policy:
      deny_tools:
      - propose_delegate_task
      - delegate_task
      mode: require_workflow
    program_type: content_to_jira_work_orders
    signals:
    - plan work from this content
    - content to work orders
    - file work orders as jira
  - entry_phase: bug_intake
    exclude:
    - what error
    - error handling
    id: bug_to_jira
    orchestrator_hint: 'User wants a bug filed as one unassigned Jira Bug. Call propose_start_program
      with program_type=bug_to_jira_work_orders and entry_phase=bug_intake. Do not
      call propose_delegate_task or start software_delivery.

      '
    policy:
      deny_tools:
      - propose_delegate_task
      - delegate_task
      mode: require_workflow
    program_type: bug_to_jira_work_orders
    signals:
    - file this bug
    - investigate this error
    - bug report
    - production incident
    - fix bug
    - regression
    - broken
    - error
  - entry_phase: pick
    id: jira_to_pr
    orchestrator_hint: 'User wants the decoupled implement program. Call propose_start_program
      with program_type=jira_to_pr. If they pasted a ticket key, use entry_phase=implement
      and artifacts.jira_issue_key. Otherwise entry_phase=pick.

      '
    policy:
      deny_tools:
      - propose_delegate_task
      - delegate_task
      mode: require_workflow
    program_type: jira_to_pr
    signals:
    - my tickets
    - pick up my jira
    - implement TFS-
  - id: code_intake
    orchestrator_hint: 'Vague code request. Ask once whether this is a bug or a feature.
      Do not draft, do not call propose_delegate_task, and do not start software_delivery.
      After they answer, call propose_start_program with program_type=bug_to_jira_work_orders
      and entry_phase=bug_intake, or program_type=content_to_jira_work_orders and
      entry_phase=intake.

      '
    policy:
      allow_program_types:
      - bug_to_jira_work_orders
      - content_to_jira_work_orders
      deny_tools:
      - propose_delegate_task
      - delegate_task
      mode: require_workflow
    signals:
    - open pr
    - refactor
    - change the
sandbox:
  backend: docker
  cpu_limit: 1.0
  egress_policy: deny
  memory_mb: 512
  mode: docker
  timeout_seconds: 300
tenants:
- data_residency: us
  display_name: Default Tenant
  enabled_connectors:
  - slack
  - mcp-atlassian
  - google-workspace
  id: default
toolsets:
  channel:
  - channel_send
  channel-chat:
  - propose_delegate_task
  - propose_start_workflow
  - propose_continue_delivery
  - propose_bridge_workflow
  - propose_set_program_project
  - propose_link_program
  - unlink_program
  - set_program_autoshare
  - workflow_status
  coding-backend:
  - run_coding_backend
  core-read:
  - recall_memory
  - read_file
  - session_status
  - remember_memory
  - sessions_list
  - sessions_history
  - search_sessions
  - read_skill_reference
  core-write:
  - write_file
  - patch_file
  delegation:
  - delegate_task
  - propose_delegate_task
  google-workspace: []
  google-workspace-docs:
  - google_workspace_drive_search
  - google_workspace_drive_get
  - google_workspace_drive_create
  - google_workspace_docs_read
  - google_workspace_docs_append
  mcp: []
  program-builder:
  - builder_catalog
  - propose_program_bundle
  skill-authoring:
  - propose_skill
  terminal:
  - exec
  workflow:
  - workflow_update
  workflow-promotion:
  - propose_start_workflow
  - start_workflow
  - propose_continue_delivery
  - continue_delivery
  - propose_bridge_workflow
  - bridge_workflow
  - workflow_status
  - workflow_approve
  - workflow_reject
  - workflow_reject_with_feedback
  - cancel_workflow
  - resume_external_event
  - propose_set_program_project
  - set_program_project
  - propose_link_program
  - link_program
  - unlink_program
  - set_program_autoshare
