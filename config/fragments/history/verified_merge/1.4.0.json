{
  "fragment_id": "verified_merge",
  "definition_version": "1.4.0",
  "display_name": "PR checks, code review, QA gate, freshness, human merge",
  "description": "Publish the host security scan, wait for PR checks, run an independent automated code review and the QA gate, each with a revise loop back to the implement stage, confirm each PR contains its base branch head (refreshing it when the base moved), then wait for the human merge.",
  "params": {
    "implement_stage": {
      "kind": "stage_ref",
      "required": true,
      "description": "Stage that opens the PR and is revised when code review or QA rejects it"
    }
  },
  "inputs": {
    "repo_url": {
      "required": true
    },
    "base_branch": {
      "required": true
    },
    "work_order_body": {
      "required": true
    },
    "work_order_ref": {
      "required": true
    }
  },
  "contracts": {
    "code_review": {
      "output_schema": {
        "type": "object",
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "verdict",
              "summary",
              "prs",
              "findings"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "pass",
                  "block"
                ]
              },
              "summary": {
                "type": "string"
              },
              "prs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "pr_url"
                  ],
                  "properties": {
                    "pr_url": {
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "head_sha": {
                      "type": "string"
                    }
                  }
                }
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "severity",
                    "category",
                    "pr_url",
                    "message"
                  ],
                  "properties": {
                    "severity": {
                      "enum": [
                        "blocker",
                        "major",
                        "minor",
                        "nit"
                      ]
                    },
                    "category": {
                      "enum": [
                        "correctness",
                        "security",
                        "scope",
                        "tests",
                        "maintainability"
                      ]
                    },
                    "pr_url": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      },
      "semantic_validators": [
        "validate_code_review_envelope"
      ]
    },
    "qa_gate": {
      "output_schema": {
        "type": "object",
        "required": [
          "status",
          "result"
        ],
        "properties": {
          "status": {
            "enum": [
              "success",
              "failed"
            ]
          },
          "result": {
            "type": "object",
            "required": [
              "prs"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "prs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "pr_url",
                    "work_item_ref",
                    "status"
                  ],
                  "properties": {
                    "pr_url": {
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "work_item_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "enum": [
                        "success",
                        "failed"
                      ]
                    },
                    "acceptance_criteria": {
                      "type": "array"
                    },
                    "tests": {
                      "type": "array"
                    },
                    "defects": {
                      "type": "array"
                    },
                    "summary": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "warnings": {
            "type": "array"
          },
          "follow_up_needed": {
            "type": "boolean"
          }
        }
      },
      "outcome": {
        "pointer": "/status",
        "succeeded_values": [
          "success"
        ],
        "blocked_values": [
          "failed"
        ]
      },
      "semantic_validators": [
        "validate_qa_pr_url_set"
      ]
    }
  },
  "stages": [
    {
      "name": "await_pr_checks",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": [
        "{{param.implement_stage}}"
      ],
      "approval_required": false,
      "wait_external": {
        "hook": "wait_external",
        "event_type": "github.pr_checks",
        "pr_checks": {
          "pr_url": "$prior.{{param.implement_stage}}.output.pr_url",
          "security": "$prior.{{param.implement_stage}}.output.security"
        },
        "timeout_seconds": 86400
      },
      "on_complete": {
        "hook": "hydrate_input",
        "downstream": [
          "review_precheck",
          "code_review",
          "qa_gate"
        ]
      },
      "retry": {
        "max_retries": 3,
        "timeout_seconds": 86400
      }
    },
    {
      "name": "review_precheck",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": [
        "await_pr_checks"
      ],
      "approval_required": false,
      "barrier": {
        "hook": "review_precheck",
        "pr_url": "$prior.{{param.implement_stage}}.output.pr_url",
        "work_order_body": "$input.work_order_body",
        "refresh": "$prior.{{param.implement_stage}}.output.refresh_method"
      },
      "on_complete": {
        "hook": "hydrate_input",
        "downstream": [
          "code_review"
        ]
      },
      "retry": {
        "max_retries": 1,
        "timeout_seconds": 600
      }
    },
    {
      "name": "code_review",
      "kind": "task",
      "agent_id": "review-agent",
      "allowed_agents": [
        "review-agent"
      ],
      "depends_on": [
        "review_precheck"
      ],
      "contract_ref": "code_review",
      "skill_hints": [
        "governed-code-review"
      ],
      "input_map": {
        "pr_url": "$prior.{{param.implement_stage}}.output.pr_url",
        "work_order_id": "$prior.{{param.implement_stage}}.output.work_order_id",
        "work_order_ref": "$input.work_order_ref",
        "work_order_body": "$input.work_order_body",
        "prs": "$prior.review_precheck.output.prs",
        "files": "$prior.review_precheck.output.files",
        "diff_stats": "$prior.review_precheck.output.diff_stats",
        "scope_findings": "$prior.review_precheck.output.scope_findings",
        "refresh": "$prior.review_precheck.output.refresh"
      },
      "retry": {
        "max_retries": 1,
        "timeout_seconds": 3600
      }
    },
    {
      "name": "finalize_code_review",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": [
        "code_review"
      ],
      "approval_required": false,
      "barrier": {
        "hook": "finalize_code_review",
        "review": "$prior.code_review.output",
        "precheck": "$prior.review_precheck.output"
      },
      "on_block": {
        "hook": "revise_on_reject",
        "max_revisions": 3,
        "revise": {
          "step_name": "{{param.implement_stage}}",
          "agent_id": "dev-agent",
          "source_steps": [
            "{{param.implement_stage}}"
          ],
          "input_map": {
            "review_feedback": "$reject.comments",
            "revision_files": "$prior.finalize_code_review.output.revision_files",
            "pr_url": "$prior.{{param.implement_stage}}.output.pr_url",
            "revision_number": "$runtime.revision_count:{{param.implement_stage}}"
          }
        },
        "re_gate": {
          "step_name": "await_pr_checks",
          "agent_id": "orchestrator",
          "approval_required": false,
          "depends_on": [
            "$revise.id"
          ]
        },
        "resume_after": [
          {
            "step_name": "review_precheck",
            "agent_id": "orchestrator",
            "depends_on": [
              "$re_gate.id"
            ]
          },
          {
            "step_name": "code_review",
            "agent_id": "review-agent",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "finalize_code_review",
            "agent_id": "orchestrator",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "qa_gate",
            "agent_id": "qa-agent",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "ensure_fresh",
            "agent_id": "orchestrator",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "await_human_merge",
            "agent_id": "orchestrator",
            "depends_on": [
              "$previous.id"
            ]
          }
        ]
      },
      "retry": {
        "max_retries": 0,
        "timeout_seconds": 600
      }
    },
    {
      "name": "qa_gate",
      "kind": "task",
      "agent_id": "qa-agent",
      "allowed_agents": [
        "qa-agent"
      ],
      "depends_on": [
        "finalize_code_review"
      ],
      "contract_ref": "qa_gate",
      "skill_hints": [
        "governed-qa-gate"
      ],
      "present_prompt": "merge",
      "input_map": {
        "pr_url": "$prior.{{param.implement_stage}}.output.pr_url",
        "work_order_id": "$prior.{{param.implement_stage}}.output.work_order_id",
        "work_order_ref": "$input.work_order_ref",
        "work_order_body": "$input.work_order_body",
        "repo_url": "$input.repo_url",
        "base_branch": "$input.base_branch",
        "host_verify_summary": "$prior.{{param.implement_stage}}.output.verify_summary",
        "checks_state": "$prior.await_pr_checks.output.checks_state",
        "checks": "$prior.await_pr_checks.output.checks",
        "failed_checks": "$prior.await_pr_checks.output.failed_checks",
        "host_security": "$prior.{{param.implement_stage}}.output.security"
      },
      "on_block": {
        "hook": "revise_on_reject",
        "max_revisions": 3,
        "revise": {
          "step_name": "{{param.implement_stage}}",
          "agent_id": "dev-agent",
          "source_steps": [
            "{{param.implement_stage}}"
          ],
          "input_map": {
            "qa_feedback": "$reject.comments",
            "pr_url": "$prior.{{param.implement_stage}}.output.pr_url",
            "revision_number": "$runtime.revision_count:{{param.implement_stage}}"
          }
        },
        "re_gate": {
          "step_name": "await_pr_checks",
          "agent_id": "orchestrator",
          "approval_required": false,
          "depends_on": [
            "$revise.id"
          ]
        },
        "resume_after": [
          {
            "step_name": "review_precheck",
            "agent_id": "orchestrator",
            "depends_on": [
              "$re_gate.id"
            ]
          },
          {
            "step_name": "code_review",
            "agent_id": "review-agent",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "finalize_code_review",
            "agent_id": "orchestrator",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "qa_gate",
            "agent_id": "qa-agent",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "ensure_fresh",
            "agent_id": "orchestrator",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "await_human_merge",
            "agent_id": "orchestrator",
            "depends_on": [
              "$previous.id"
            ]
          }
        ]
      },
      "retry": {
        "max_retries": 1,
        "timeout_seconds": 3600
      }
    },
    {
      "name": "ensure_fresh",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": [
        "qa_gate"
      ],
      "approval_required": false,
      "barrier": {
        "hook": "ensure_fresh",
        "pr_urls": "$prior.qa_gate.output.result.prs"
      },
      "on_block": {
        "hook": "revise_on_reject",
        "max_revisions": 5,
        "revise": {
          "step_name": "{{param.implement_stage}}",
          "agent_id": "dev-agent",
          "budget": "refresh",
          "static_input": {
            "refresh": true
          },
          "source_steps": [
            "{{param.implement_stage}}"
          ],
          "input_map": {
            "pr_url": "$prior.{{param.implement_stage}}.output.pr_url"
          }
        },
        "re_gate": {
          "step_name": "await_pr_checks",
          "agent_id": "orchestrator",
          "approval_required": false,
          "depends_on": [
            "$revise.id"
          ]
        },
        "resume_after": [
          {
            "step_name": "review_precheck",
            "agent_id": "orchestrator",
            "depends_on": [
              "$re_gate.id"
            ]
          },
          {
            "step_name": "code_review",
            "agent_id": "review-agent",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "finalize_code_review",
            "agent_id": "orchestrator",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "qa_gate",
            "agent_id": "qa-agent",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "ensure_fresh",
            "agent_id": "orchestrator",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "await_human_merge",
            "agent_id": "orchestrator",
            "depends_on": [
              "$previous.id"
            ]
          }
        ]
      },
      "retry": {
        "max_retries": 0,
        "timeout_seconds": 600
      }
    },
    {
      "name": "await_human_merge",
      "kind": "task",
      "agent_id": "orchestrator",
      "depends_on": [
        "ensure_fresh"
      ],
      "approval_required": false,
      "wait_external": {
        "hook": "wait_external",
        "event_type": "github.merge",
        "match_all": {
          "source": "$prior.qa_gate.output.result.prs",
          "item_key": "pr_url"
        },
        "timeout_seconds": 86400
      },
      "on_block": {
        "hook": "revise_on_reject",
        "max_revisions": 5,
        "revise": {
          "step_name": "{{param.implement_stage}}",
          "agent_id": "dev-agent",
          "budget": "refresh",
          "static_input": {
            "refresh": true
          },
          "source_steps": [
            "{{param.implement_stage}}"
          ],
          "input_map": {
            "pr_url": "$prior.{{param.implement_stage}}.output.pr_url"
          }
        },
        "re_gate": {
          "step_name": "await_pr_checks",
          "agent_id": "orchestrator",
          "approval_required": false,
          "depends_on": [
            "$revise.id"
          ]
        },
        "resume_after": [
          {
            "step_name": "review_precheck",
            "agent_id": "orchestrator",
            "depends_on": [
              "$re_gate.id"
            ]
          },
          {
            "step_name": "code_review",
            "agent_id": "review-agent",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "finalize_code_review",
            "agent_id": "orchestrator",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "qa_gate",
            "agent_id": "qa-agent",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "ensure_fresh",
            "agent_id": "orchestrator",
            "depends_on": [
              "$previous.id"
            ]
          },
          {
            "step_name": "await_human_merge",
            "agent_id": "orchestrator",
            "depends_on": [
              "$previous.id"
            ]
          }
        ]
      },
      "retry": {
        "max_retries": 0,
        "timeout_seconds": 86400
      }
    }
  ]
}
